# SQLite database path (used by Prisma)
DATABASE_URL=file:./prisma/dev.db

# Rust backend URL — Next.js proxies all /api/* requests here.
# In development, run `bun run backend:dev` separately on port 8080.
# In Docker, this is set automatically to http://localhost:8080.
BACKEND_URL=http://localhost:8080

# (Optional) Restrict which HTTP origin may call the Rust backend directly.
# Leave unset in development; set to your domain in production if port 8080
# is ever exposed outside the container.
# ALLOWED_ORIGIN=https://yourapp.example.com

# Finance Settings
# Enable/disable currency exchange rates and converter widget
# Set to 'true' to enable live exchange rates (uses Frankfurter API - free, no key required)
# Set to 'false' to disable currency converter widget
NEXT_PUBLIC_ENABLE_CURRENCY_CONVERTER=true
